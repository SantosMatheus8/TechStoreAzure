[Unit]
Description=TechStore API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/techstore-api
ExecStart=/usr/bin/dotnet /opt/techstore-api/TechStore.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=techstore-api
TimeoutStopSec=30

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=KeyVault__Uri=https://kv-techstore-matheus.vault.azure.net/
Environment=AllowedOrigins=https://sttechstore31459.z9.web.core.windows.net

[Install]
WantedBy=multi-user.target
